<?xml version="1.0" encoding="utf-8"?>
<!--
    player_ui.xml — разметка интерфейса PlayerWindow

    margin="л,т,п,н"  — setContentsMargins layout-а этого элемента
    margin="8"         — все стороны одинаково
    spacing="6"        — setSpacing layout-а этого элемента

    Кастомные виджеты зарегистрированы в main.py:
        gradientImageLabel  → GradientImageLabel
        fixedComboBox       → FixedComboBox
        waveformSeekBar     → WaveformSeekBar
        visualizerWindow    → VisualizerWindow
-->

<!-- Корневой контейнер: VBox без отступов, нулевой spacing -->
<qwidget flex="v" margin="0" spacing="0"
         meta-name="Metter"
         meta-author="Maxsspeaker"
         meta-version="6.0.1"
         meta-description="MSMP 5 тема, в стиле метро-дизайна. Тёмный монохром">

    <!-- ═══════════════════════════════════════════════════════════════
         NowDisplay: обложка / мета / визуализатор / waveform-seekbar
         ═══════════════════════════════════════════════════════════════ -->

    <systemmenubar id="MainMenuBar" visible="true"/>

    <qwidget margin="16,0,16,0" id="NowDisplay" fixed-height="180"
             flex="v" spacing="0">

        <!-- Строка: обложка + мета + визуализатор
             margin="16,16,16,0" → left=16 top=16 right=16 bottom=0  -->
        <qwidget id="playNowRow" flex="h"
                 margin="0,0,0,0" spacing="0"
                 stretch="1">


            <qwidget id="audio_block" flex="v"
                     style="padding: 0px 6px;"  fixed-height="90" fixed-width="170" spacing="0"
                     stretch="0">

                <qlabel id="time_label" text="0:00 / 0:00"
                        style="color:#fff; font-size:23px; margin:0px; text-aling:right;" />
            

                <qwidget margin="5,0,5,5"  id="visualizer_block" flex="v" fixed-width="170" spacing="0"
                         stretch="0">

                    <visualizerWindow id="visualizer_window"
                                      fixed-width="160" fixed-height="50" />

                </qwidget>

            </qwidget>


            <!-- Мета-блок: заголовок + исполнитель + альбом, прижаты к центру -->
            <qwidget id="metaBlock" flex="v"
                     margin="0" spacing="0"
                     stretch="0">

                <qwidget id="infoPlayBlock" flex="h"
                    margin="0,0,5,0" spacing="0"
                    stretch="1">

                    <qwidget id="metaAudioBlock" flex="v" margin="0" spacing="0" stretch="1">

                        <qwidget stretch="1" />
                        <label id="track_title_label" style="color:#fff; font-size:19px; font-weight:700;margin:2px; margin-left:10px;" />
                        <label id="artist_label" style="color:#fff; font-size:14px; margin:2px; margin-left:10px;" />
                        <label id="album_label" style="color:#fff; font-size:14px; margin:2px; margin-left:10px;" />
                        <qwidget stretch="1" />

                    </qwidget>
                </qwidget>
            </qwidget>
        </qwidget>

        <qwidget margin="12,2,12,0"  id="control_box" flex="v">

            <qjumpslider orientation="h" id="position_slider" />

            <qwidget id="buttonRow" flex="h" margin="0,6,0,6" spacing="8">

                <!-- левый распор -->

                <qpushbutton class="control_buttons" id="prev_button"    icon="{internal}/resources/previous.svg"     connect="play_previous" />
                <qpushbutton class="control_buttons" id="stop_button"    icon="{internal}/resources/stop.svg"         connect="stop_playback" />
                <qpushbutton class="control_buttons" id="play_button"    icon="{internal}/resources/play.svg"         connect="play_selected_or_current" />
                <qpushbutton class="control_buttons" id="pause_button"   icon="{internal}/resources/pause.svg"        connect="pause_playback" />
                <qpushbutton class="control_buttons" id="next_button"    icon="{internal}/resources/next.svg"         connect="play_next" />

                <qpushbutton style="margin: 0px 10px;" class="control_buttons" id="restart_button" icon="{internal}/resources/reload-audio.svg" connect="restart_current_stream" />

                <!-- правый распор — в 3 раза шире левого, прижимает кнопки к центру -->
                <qwidget stretch="3" />

                <qpushbutton class="control_buttons" id="mode_button" connect="toggle_play_mode" />

                <qslider id="volume_slider"
                         orientation="h"
                         min="0" max="100" value="80"
                         fixed-width="120"
                         connect="on_volume_slider_changed" />

            </qwidget>

        </qwidget>
        

    </qwidget>


    <!-- ═══════════════════════════════════════════════════════════════
         playlistBox: таблица + строка управления плейлистом
         margin="0" — без внешних отступов, как в оригинале
         ═══════════════════════════════════════════════════════════════ -->
    <qwidget id="playlistBox" flex="v"
             margin="0" spacing="0">

        <playlistwidget id="playlist_table" stretch="1" rowHeight="12" inlineAudio="true"/>

        <!-- Строка управления: Add / URL / cookies / Clear / Save / Load
             spacing="6" соответствует оригинальному playlist_menu.setSpacing(6) -->
        <qwidget id="playlistMenu" flex="h"
                 margin="6" spacing="6">

            <qpushbutton id="add_button" text="Add" connect="add_url" />

            <qlineedit id="url_input"
                       placeholder="URL for yt-dlp"
                       stretch="1" />

            <qpushbutton id="clear_button" text="Clear" connect="clear_playlist" />
            <qpushbutton id="save_button"  text="Save"  connect="save_playlist" />
            <qpushbutton id="load_button"  text="Load"  connect="load_playlist" />

        </qwidget>

    </qwidget>

    <!-- Статусная строка -->
    <label id="status_label" text="Ready"
            style="color:#8f8f8f; padding:5px 10px; border-top:1px solid #161616;" />

</qwidget>
